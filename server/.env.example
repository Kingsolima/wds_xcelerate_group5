# Copy to server/.env and fill in. Never commit .env.
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Auth
JWT_SECRET=change-me

# Database: Neon (AWS us-east-1). Use the *pooled* connection string
# from your own Neon dev branch, e.g.
# postgresql://user:pass@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
