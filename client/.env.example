# Copy to client/.env and fill in. Never commit .env.
# The Neon Auth URL, NOT the Express server: copy NEON_AUTH_BASE_URL from server/.env.
# It looks like https://ep-xxx.neonauth.<region>.aws.neon.tech/neondb/auth
# If Neon refuses sign-in from the dev server, add http://localhost:5173 to its allowed domains.
VITE_NEON_AUTH_URL=
